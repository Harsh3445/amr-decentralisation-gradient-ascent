#define ENA 14
#define ENB 13

#define IN1 27
#define IN2 26
#define IN3 25
#define IN4 33

void setup() {

  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // Enable motors
  digitalWrite(ENA, HIGH);
  digitalWrite(ENB, HIGH);

  // Forward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

void loop() {
}
