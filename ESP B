// =====================================================================
//  SHARED BLOCK 2/2 : FUNCTIONS  (identical in all three sketches)
//  Both robots run the SAME deterministic functions on the SAME data,
//  so they always agree on who replans - no master needed.
// =====================================================================
inline uint8_t cellIdx(uint8_t x, uint8_t y) { return y * GRID_SIZE + x; }
inline uint8_t cellX(uint8_t c) { return c % GRID_SIZE; }
inline uint8_t cellY(uint8_t c) { return c / GRID_SIZE; }
inline bool inGrid(int x, int y) { return x >= 0 && x < GRID_SIZE && y >= 0 && y < GRID_SIZE; }
inline bool isFree(int x, int y) { return inGrid(x, y) && GRID_MAP[y][x] == 0; }
inline int  manhattan(int x1, int y1, int x2, int y2) { return abs(x1 - x2) + abs(y1 - y2); }

inline char idFromMac(const uint8_t* m) {
  for (int i = 0; i < FLEET_SIZE; i++) if (memcmp(m, FLEET[i].mac, 6) == 0) return FLEET[i].id;
  return 0;
}
inline const uint8_t* macOf(char id) {
  for (int i = 0; i < FLEET_SIZE; i++) if (FLEET[i].id == id) return FLEET[i].mac;
  return nullptr;
}

inline void fillHeader(MsgHeader& h, uint8_t type, char sender, uint16_t seq) {
  h.magic = PROTO_MAGIC; h.ver = PROTO_VER; h.type = type; h.sender = sender; h.seq = seq;
}
inline bool validHeader(const uint8_t* d, int len) {
  return len >= (int)sizeof(MsgHeader) && d[0] == PROTO_MAGIC && d[1] == PROTO_VER;
}

inline const char* conflictName(uint8_t t) {
  static const char* n[] = {"NONE", "SAME CELL", "HEAD-ON SWAP", "TAILGATE"};
  return t < 4 ? n[t] : "?";
}
inline const char* reasonName(uint8_t r) {
  static const char* n[] = {"-", "NEW GOAL", "AVOID COLLISION CELL", "WAIT 1 STEP", "START POSITION SET",
                            "JOB CLEARED", "SIDESTEP TO MAKE WAY"};
  return r < 7 ? n[r] : "?";
}

// integer hash -> used as a coin flip both robots compute identically
inline uint32_t mix32(uint32_t x) {
  x ^= x >> 16; x *= 0x7FEB352DUL; x ^= x >> 15; x *= 0x846CA68BUL; x ^= x >> 16;
  return x;
}

inline bool inList(const uint8_t* l, uint8_t n, uint8_t c) {
  for (int i = 0; i < n; i++) if (l[i] == c) return true;
  return false;
}

// ---------------- A* : shortest 4-connected path ----------------
// blocked[] cells are walls (start and goal are never blocked).
// out[t-1] = cell at step t; outLen = number of steps.
inline bool planAStar(uint8_t start, uint8_t goal, const uint8_t* blocked, uint8_t nBlocked,
                      uint8_t* out, uint8_t& outLen) {
  const int N = GRID_SIZE * GRID_SIZE;
  uint16_t g[N], f[N];
  int8_t   parent[N];
  bool     open[N], closed[N];
  for (int i = 0; i < N; i++) { g[i] = 0xFFFF; f[i] = 0xFFFF; parent[i] = -1; open[i] = false; closed[i] = false; }

  int gx = cellX(goal), gy = cellY(goal);
  g[start] = 0;
  f[start] = manhattan(cellX(start), cellY(start), gx, gy);
  open[start] = true;

  const int dx[4] = {1, -1, 0, 0};
  const int dy[4] = {0, 0, 1, -1};

  while (true) {
    int best = -1;
    uint16_t bf = 0xFFFF;
    for (int i = 0; i < N; i++)
      if (open[i] && !closed[i] && f[i] < bf) { bf = f[i]; best = i; }
    if (best < 0) return false;
    if (best == goal) break;
    closed[best] = true;

    int bx = cellX(best), by = cellY(best);
    for (int k = 0; k < 4; k++) {
      int nx = bx + dx[k], ny = by + dy[k];
      if (!isFree(nx, ny)) continue;
      int n = cellIdx(nx, ny);
      if (closed[n]) continue;
      if (n != goal && inList(blocked, nBlocked, n)) continue;
      uint16_t ng = g[best] + 1;
      if (!open[n] || ng < g[n]) {
        g[n] = ng;
        f[n] = ng + manhattan(nx, ny, gx, gy);
        parent[n] = best;
        open[n] = true;
      }
    }
  }

  uint8_t rev[N];
  int len = 0;
  for (int c = goal; c != start; c = parent[c]) {
    if (len >= N || parent[c] < 0) return false;
    rev[len++] = c;
  }
  if (len > MAX_PLAN) return false;
  outLen = len;
  for (int i = 0; i < len; i++) out[i] = rev[len - 1 - i];
  return true;
}

// where robot r is at step t (t = 0 -> now); after its plan ends it stays put
inline uint8_t cellAt(const RobotSnap& r, int t) {
  if (t <= 0 || r.planLen == 0) return r.pos;
  if (t - 1 < r.planLen) return r.plan[t - 1];
  return r.plan[r.planLen - 1];
}

// First future collision between two plans, stepping through time together.
//   SAME CELL : both in one cell at step t
//   SWAP      : they exchange cells between t-1 and t (head-on)
//   TAILGATE  : one enters the cell the other is only just leaving
inline bool detectConflict(const RobotSnap& a, const RobotSnap& b, Conflict& c) {
  int T = (a.planLen > b.planLen ? a.planLen : b.planLen) + 1;
  for (int t = 1; t <= T; t++) {
    uint8_t a0 = cellAt(a, t - 1), a1 = cellAt(a, t);
    uint8_t b0 = cellAt(b, t - 1), b1 = cellAt(b, t);
    uint8_t type = CT_NONE;
    if (a1 == b1)                    type = CT_VERTEX;
    else if (a1 == b0 && b1 == a0)   type = CT_SWAP;
    else if (a1 == b0 || b1 == a0)   type = CT_FOLLOW;
    if (type != CT_NONE) { c.type = type; c.t = t; c.cellA = a1; c.cellB = b1; return true; }
  }
  return false;
}

// Replan robot r with 'cell' added as an obstacle. Not allowed on its own
// position or goal (that could never be avoided).
inline bool tryBlock(const RobotSnap& r, uint8_t cell, uint8_t* out, uint8_t& len) {
  if (r.goal == NONE || cell == r.pos || cell == r.goal || r.nBlocked >= MAX_BLOCKED) return false;
  uint8_t bl[MAX_BLOCKED];
  memcpy(bl, r.blocked, r.nBlocked);
  bl[r.nBlocked] = cell;
  return planAStar(r.pos, r.goal, bl, r.nBlocked + 1, out, len);
}

inline bool canWait(const RobotSnap& r) { return r.goal != NONE && r.planLen > 0 && r.planLen < MAX_PLAN; }

// Used when the collision cell can't be made an obstacle (e.g. two adjacent robots
// that want to swap places: each one's collision cell is its own goal).
// Robot r steps into a free neighbour the other robot isn't using, and plans its
// way back to its goal AROUND the other robot's remaining route and parking cell.
inline bool trySidestep(const RobotSnap& r, const RobotSnap& other, uint8_t* out, uint8_t& len) {
  const int dx[4] = {1, -1, 0, 0};
  const int dy[4] = {0, 0, 1, -1};
  uint8_t o0 = cellAt(other, 0), o1 = cellAt(other, 1);

  // cells to keep clear on the way back: other robot's position, route and final cell
  uint8_t avoid[MAX_BLOCKED + MAX_PLAN + 1];
  uint8_t na = 0;
  for (int i = 0; i < r.nBlocked; i++) avoid[na++] = r.blocked[i];
  avoid[na++] = other.pos;
  for (int t = 0; t < other.planLen; t++) avoid[na++] = other.plan[t];

  int best = -1, bestScore = 9999;
  uint8_t bestRest[MAX_PLAN], bestLen = 0;
  for (int k = 0; k < 4; k++) {
    int nx = cellX(r.pos) + dx[k], ny = cellY(r.pos) + dy[k];
    if (!isFree(nx, ny)) continue;
    uint8_t n = cellIdx(nx, ny);
    if (n == o0 || n == o1) continue;
    int score = 0;
    uint8_t rest[MAX_PLAN], rl = 0;
    if (r.goal != NONE && n != r.goal) {
      if (!planAStar(n, r.goal, avoid, na, rest, rl) &&            // around the other robot
          !planAStar(n, r.goal, r.blocked, r.nBlocked, rest, rl))  // any route at all
        continue;
      score = rl;
    }
    for (int t = 0; t < other.planLen; t++) if (other.plan[t] == n) { score += 10; break; }
    if (score < bestScore && rl + 1 <= MAX_PLAN) {
      bestScore = score; best = n; bestLen = rl; memcpy(bestRest, rest, rl);
    }
  }
  if (best < 0) return false;
  out[0] = best;
  memcpy(out + 1, bestRest, bestLen);
  len = 1 + bestLen;
  return true;
}

// Who fixes the conflict, and how:
//   1. Coin flip (hash of both boot nonces + conflict + plan versions) picks a robot.
//      That robot treats its collision cell as an OBSTACLE and replans (A*).
//   2. If it can't (cell is its own start/goal, or no route), the other robot tries.
//   3. If neither can (e.g. adjacent robots swapping places), one steps
//      aside into a free neighbour cell to make way, then replans.
//   4. Last resort: one of them waits 1 step.
//   A TAILGATE is always fixed by the follower waiting 1 step.
inline Resolution chooseResolution(const Conflict& c, const RobotSnap& a, const RobotSnap& b) {
  Resolution r;
  r.robot = 0; r.action = ACT_NONE; r.cell = NONE;
  uint32_t seed = a.nonce ^ (b.nonce * 2654435761UL) ^ ((uint32_t)c.t << 8) ^
                  ((uint32_t)c.cellA << 16) ^ ((uint32_t)c.cellB << 24) ^
                  ((uint32_t)a.ver * 40503UL) ^ ((uint32_t)b.ver * 9973UL);
  r.coin = mix32(seed) & 1;

  if (c.type == CT_FOLLOW) {
    bool aFollows = (cellAt(a, c.t) == cellAt(b, c.t - 1));
    const RobotSnap& fol = aFollows ? a : b;
    if (canWait(fol)) { r.robot = fol.id; r.action = ACT_WAIT; return r; }
  }

  const RobotSnap* order[2] = { r.coin ? &b : &a, r.coin ? &a : &b };
  uint8_t tmp[MAX_PLAN];
  uint8_t len = 0;
  for (int i = 0; i < 2; i++) {
    uint8_t cell = (order[i] == &a) ? c.cellA : c.cellB;
    if (tryBlock(*order[i], cell, tmp, len)) {
      r.robot = order[i]->id; r.action = ACT_BLOCK; r.cell = cell;
      return r;
    }
  }
  for (int i = 0; i < 2; i++) {
    const RobotSnap& oth = (order[i] == &a) ? b : a;
    if (trySidestep(*order[i], oth, tmp, len)) {
      r.robot = order[i]->id; r.action = ACT_SIDESTEP; r.cell = tmp[0];
      return r;
    }
  }
  for (int i = 0; i < 2; i++)
    if (canWait(*order[i])) { r.robot = order[i]->id; r.action = ACT_WAIT; return r; }
  return r;                                         // nothing possible -> reported as STUCK
}

