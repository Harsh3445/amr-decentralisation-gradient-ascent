// =====================================================================
// SNAPSHOTS for the shared functions
// =====================================================================
void snapSelf(RobotSnap& r) {
  r.id = ROBOT_ID;  r.pos = pos;  r.goal = goal;  r.ver = planVer;  r.nonce = nonce;
  r.nBlocked = nBlocked;  memcpy(r.blocked, blocked, nBlocked);
  r.planLen = planLen;    memcpy(r.plan, plan, planLen);
}

void snapPeer(RobotSnap& r) {
  const StateMsg& s = peer.s;
  r.id = PEER_ID;
  r.pos = cellIdx(s.x, s.y);
  r.goal = (s.gx == NONE) ? NONE : cellIdx(s.gx, s.gy);
  r.ver = s.planVer;  r.nonce = s.nonce;
  r.nBlocked = s.nBlocked;  memcpy(r.blocked, s.blocked, s.nBlocked);
  r.planLen = s.planLen;    memcpy(r.plan, s.plan, s.planLen);
}

// =====================================================================
// SENDING
// =====================================================================
void sendRaw(const void* p, size_t n) {
  esp_now_send(nullptr, (const uint8_t*)p, n);     // NULL -> every fleet peer (unicast, ACKed)
}

void broadcastState() {
  StateMsg m;
  memset(&m, 0, sizeof(m));
  fillHeader(m.h, MSG_STATE, ROBOT_ID, seqNo++);
  m.x = cellX(pos);  m.y = cellY(pos);
  m.gx = (goal == NONE) ? NONE : cellX(goal);
  m.gy = (goal == NONE) ? NONE : cellY(goal);
  m.jobId = jobId;  m.resetId = resetId;
  m.arrived = arrived;
  m.step = step;
  m.planVer = planVer;
  m.seenPeerVer = peer.valid ? peer.s.planVer : 0;
  m.ready = ready;  m.readyMyVer = readyMyVer;  m.readyPeerVer = readyPeerVer;
  m.running = running;
  m.planReason = planReason;  m.reasonCell = reasonCell;
  m.nonce = nonce;
  m.nBlocked = nBlocked;  memcpy(m.blocked, blocked, nBlocked);
  m.planLen = planLen;    memcpy(m.plan, plan, planLen);
  sendRaw(&m, sizeof(m));
  lastState = millis();
}

void emitEvent(uint8_t ev, const Conflict* c, const Resolution* r) {
  EventMsg e;
  memset(&e, 0, sizeof(e));
  fillHeader(e.h, MSG_EVENT, ROBOT_ID, seqNo++);
  e.ev = ev;  e.step = step;
  e.x = cellX(pos);  e.y = cellY(pos);
  e.blockCell = NONE;
  if (c) { e.t = c->t; e.ctype = c->type; e.cellA = c->cellA; e.cellB = c->cellB; }
  if (r) { e.resolver = r->robot; e.action = r->action; e.blockCell = r->cell; e.coin = r->coin; }
  sendRaw(&e, sizeof(e));
}

// =====================================================================
// PLANNING
// =====================================================================
void printPath(const char* who, uint8_t from, const uint8_t* p, uint8_t n) {
  Serial.print(who);
  printCellC(from);
  for (int i = 0; i < n; i++) { Serial.print(" -> "); printCellC(p[i]); }
  Serial.printf("   (%u steps)\n", n);
}

void setPlan(const uint8_t* p, uint8_t n, uint8_t reason, uint8_t cell) {
  memcpy(plan, p, n);
  planLen = n;
  planVer++;
  planReason = reason;
  reasonCell = cell;
  ready = false;
  Serial.printf("[%c] PLAN v%u (%s", ROBOT_ID, planVer, reasonName(reason));
  if (reason == PR_AVOID_CELL) { Serial.print(" "); printCellC(cell); }
  Serial.print(")\n");
  printPath("      path: ", pos, plan, planLen);
  if (nBlocked) {
    Serial.print("      treating as obstacles: ");
    for (int i = 0; i < nBlocked; i++) { printCellC(blocked[i]); Serial.print(" "); }
    Serial.println();
  }
  broadcastState();
}

void checkArrived() {
  if (!arrived && goal != NONE && planLen == 0 && pos == goal) {
    arrived = true;
    nBlocked = 0;
    Serial.printf("[%c] *** REACHED GOAL (%u,%u) at step %u ***\n", ROBOT_ID, cellX(pos), cellY(pos), step);
    emitEvent(EV_ARRIVED, nullptr, nullptr);
  }
}

void newGoal(uint8_t g, uint8_t job) {
  jobId = job;
  goal = g;
  nBlocked = 0;
  arrived = false;
  if (g == NONE) {
    uint8_t dummy[1] = {0};
    setPlan(dummy, 0, PR_CLEARED, NONE);
    Serial.printf("[%c] job cleared\n", ROBOT_ID);
    return;
  }
  Serial.printf("[%c] NEW JOB #%u: goal (%u,%u)\n", ROBOT_ID, job, cellX(g), cellY(g));
  uint8_t p[MAX_PLAN], n = 0;
  if (!planAStar(pos, goal, blocked, 0, p, n)) {
    Serial.printf("[%c] NO PATH to goal\n", ROBOT_ID);
    emitEvent(EV_NO_PATH, nullptr, nullptr);
    uint8_t dummy[1] = {0};
    setPlan(dummy, 0, PR_NEW_GOAL, NONE);
    return;
  }
  setPlan(p, n, PR_NEW_GOAL, NONE);
  checkArrived();
}

void applyReset(uint8_t rid, uint8_t x, uint8_t y) {
  resetId = rid;
  pos = cellIdx(x, y);
  arrived = false;
  nBlocked = 0;
  Serial.printf("[%c] START POSITION set to (%u,%u)\n", ROBOT_ID, x, y);
  uint8_t p[MAX_PLAN], n = 0;
  if (goal != NONE && planAStar(pos, goal, blocked, 0, p, n)) setPlan(p, n, PR_RESET, NONE);
  else { uint8_t dummy[1] = {0}; setPlan(dummy, 0, PR_RESET, NONE); }
  checkArrived();
}

// The chosen robot changes its own plan (the other one just waits for it)
void applyResolution(const Conflict& c, const Resolution& r) {
  Serial.printf("[%c] COLLISION PREDICTED: %s in %u step(s), A at ", ROBOT_ID, conflictName(c.type), c.t);
  printCellC(c.cellA);  Serial.print(", B at ");  printCellC(c.cellB);
  Serial.printf("  -> coin=%u, I (%c) resolve it\n", r.coin, ROBOT_ID);
  emitEvent(EV_CONFLICT, &c, &r);

  if (r.action == ACT_BLOCK) {
    RobotSnap me;
    snapSelf(me);
    uint8_t p[MAX_PLAN], n = 0;
    if (!tryBlock(me, r.cell, p, n)) return;        // cannot happen: same check both sides
    blocked[nBlocked++] = r.cell;
    setPlan(p, n, PR_AVOID_CELL, r.cell);
  } else if (r.action == ACT_SIDESTEP) {
    RobotSnap me, other;
    snapSelf(me);
    snapPeer(other);
    uint8_t p[MAX_PLAN], n = 0;
    if (!trySidestep(me, other, p, n)) return;
    arrived = false;
    setPlan(p, n, PR_SIDESTEP, p[0]);
  } else if (r.action == ACT_WAIT) {
    memmove(plan + 1, plan, planLen);
    plan[0] = pos;
    planLen++;
    uint8_t copy[MAX_PLAN];
    memcpy(copy, plan, planLen);
    planVer--;                                      // setPlan() increments it again
    setPlan(copy, planLen, PR_WAIT, pos);
  }
}

// =====================================================================
// ONE STEP  (both robots execute this at the same step number)
// =====================================================================
void doMove() {
  uint8_t from = pos;
  if (planLen > 0) {
    pos = plan[0];
    memmove(plan, plan + 1, planLen - 1);
    planLen--;
  }
  // ------------------------------------------------------------------
  // HARDWARE HOOK: drive from 'from' to 'pos' here (one grid cell),
  // confirm with encoders before continuing.
  // ------------------------------------------------------------------
  step++;
  lastMove = millis();
  ready = false;

  if (pos != from)
    Serial.printf("[%c] STEP %u: moved (%u,%u) -> (%u,%u)   %u step(s) left\n",
                  ROBOT_ID, step, cellX(from), cellY(from), cellX(pos), cellY(pos), planLen);
  else if (goal != NONE && !arrived)
    Serial.printf("[%c] STEP %u: waiting at (%u,%u)\n", ROBOT_ID, step, cellX(pos), cellY(pos));

  checkArrived();
  broadcastState();
}

// =====================================================================
// THE COORDINATION LOOP  (runs continuously until goals are reached)
// =====================================================================
void setReady(bool r, uint8_t peerVer) {
  if (r == ready && (!r || (readyMyVer == planVer && readyPeerVer == peerVer))) return;
  ready = r;
  readyMyVer = planVer;
  readyPeerVer = peerVer;
  broadcastState();
}

void coordinate() {
  uint32_t now = millis();
  bool peerOnline = peer.valid && (now - peer.lastSeen) < PEER_TIMEOUT_MS;

  // Peer offline -> nothing to coordinate with, move alone
  if (!peerOnline) {
    if (running && planLen > 0 && now - lastMove >= STEP_MS) doMove();
    return;
  }
  const StateMsg& p = peer.s;

  // ---- step synchronisation ----
  if (p.step > step + 1) {                           // I fell behind (e.g. rebooted)
    step = p.step;
    ready = false;
    broadcastState();
    return;
  }
  if (p.step == step + 1) {                          // peer already took this step
    if (ready && readyMyVer == planVer) doMove();    // it saw my agreed plan -> I take it too
    else { step++; lastMove = now; ready = false; broadcastState(); }   // stay put this step
    return;
  }
  if (p.step != step) return;                        // peer behind -> wait for it

  // ---- both robots must be looking at each other's latest plan ----
  if (p.seenPeerVer != planVer) { setReady(false, 0); return; }

  RobotSnap me, other;
  snapSelf(me);
  snapPeer(other);
  const RobotSnap& a = (ROBOT_ID == 'A') ? me : other;
  const RobotSnap& b = (ROBOT_ID == 'A') ? other : me;

  // ---- collision check on the two full plans ----
  Conflict c;
  if (detectConflict(a, b, c)) {
    setReady(false, 0);
    Resolution r = chooseResolution(c, a, b);        // same answer on both robots
    if (r.robot == ROBOT_ID) {
      applyResolution(c, r);                         // -> new plan -> loop checks again
    } else if (r.action == ACT_NONE) {
      uint16_t key = ((uint16_t)a.ver << 8) | b.ver;
      if (key != stuckKey) {
        stuckKey = key;
        Serial.printf("[%c] STUCK: no reroute or wait resolves the conflict\n", ROBOT_ID);
        emitEvent(EV_STUCK, &c, &r);
      }
    }
    return;
  }

  // ---- no collision: I'm ready. Move when the peer is ready too ----
  setReady(true, p.planVer);
  bool peerReady = p.ready && p.readyMyVer == p.planVer && p.readyPeerVer == planVer;
  if (running && peerReady && now - lastMove >= STEP_MS) doMove();
}

// =====================================================================
// NETWORK: identity check + unicast peers from the fleet MAC table
// =====================================================================
void checkOwnMac() {
  // Read the MAC straight from eFuse: works even before the Wi-Fi driver has
  // finished starting (WiFi.macAddress() returns 00:00:.. at that moment)
  uint8_t mine[6] = {0};
  esp_read_mac(mine, ESP_MAC_WIFI_STA);
  Serial.print("  this board MAC : ");  printMacBytes(mine);         Serial.println();
  Serial.print("  expected MAC   : ");  printMacBytes(macOf(ROBOT_ID)); Serial.println();
  if (memcmp(mine, macOf(ROBOT_ID), 6) != 0)
    Serial.println("  !!! WARNING: MAC MISMATCH - wrong sketch on this board !!!");
}

bool addFleetPeers() {
  for (int i = 0; i < FLEET_SIZE; i++) {
    if (FLEET[i].id == ROBOT_ID) continue;
    esp_now_peer_info_t pi = {};
    memcpy(pi.peer_addr, FLEET[i].mac, 6);
    pi.channel = WIFI_CHANNEL;
    pi.encrypt = false;
    if (esp_now_add_peer(&pi) != ESP_OK) return false;
    Serial.print("  peer added     : ");  printMacBytes(FLEET[i].mac);
    Serial.printf("  (%s)\n", FLEET[i].name);
  }
  return true;
}

bool packetTrusted(const RxItem& it, char claimed) {
  char id = idFromMac(it.mac);
  if (id != 0 && id == claimed) return true;
  if (++droppedUnknown <= 5) {
    Serial.print("[NET] dropped packet from untrusted MAC ");  printMacBytes(it.mac);  Serial.println();
  }
  return false;
}

// =====================================================================
// RECEIVE
// =====================================================================
void onControl(const ControlMsg& m) {
  int r = ROBOT_ID - 'A';
  if (m.running != running) {
    running = m.running;
    Serial.printf("[%c] %s received from ESP-C\n", ROBOT_ID, running ? "GO" : "STOP");
  }
  if (m.resetId[r] != resetId) applyReset(m.resetId[r], m.rx[r], m.ry[r]);
  if (m.jobId[r] != jobId) {
    uint8_t g = (m.gx[r] == NONE) ? NONE : cellIdx(m.gx[r], m.gy[r]);
    newGoal(g, m.jobId[r]);
  }
}

void onPeerState(const StateMsg& s) {
  bool newPlan = !peer.valid || peer.s.planVer != s.planVer;
  peer.s = s;
  peer.valid = true;
  peer.lastSeen = millis();
  if (newPlan) {
    Serial.printf("[%c] <- Robot %c shared plan v%u: ", ROBOT_ID, s.h.sender, s.planVer);
    printPath("", cellIdx(s.x, s.y), s.plan, s.planLen);
  }
}

void handlePacket(const RxItem& it) {
  if (!validHeader(it.data, it.len)) return;
  MsgHeader h;
  memcpy(&h, it.data, sizeof(h));
  if (!packetTrusted(it, h.sender)) return;

  if (h.type == MSG_STATE && h.sender == PEER_ID && it.len == sizeof(StateMsg)) {
    StateMsg s;  memcpy(&s, it.data, sizeof(s));  onPeerState(s);
  } else if (h.type == MSG_CONTROL && h.sender == 'C' && it.len == sizeof(ControlMsg)) {
    ControlMsg m;  memcpy(&m, it.data, sizeof(m));  onControl(m);
  }
}

void onDataRecv(const esp_now_recv_info_t* info, const uint8_t* data, int len) {
  if (len <= 0 || len > 250) return;
  RxItem it;
  memcpy(it.mac, info->src_addr, 6);
  it.len = len;
  memcpy(it.data, data, len);
  xQueueSend(rxQueue, &it, 0);
}

// =====================================================================
// SETUP / LOOP
// =====================================================================
void setup() {
  Serial.begin(115200);
  delay(800);
  WiFi.mode(WIFI_STA);
  WiFi.setChannel(WIFI_CHANNEL);
  nonce = esp_random();
  rxQueue = xQueueCreate(16, sizeof(RxItem));
  memset(&peer, 0, sizeof(peer));
  pos = cellIdx(START_X, START_Y);

  Serial.println();
  Serial.println("==============================================");
  Serial.printf ("  AUTONAV v4 - ROBOT %c   start (%u,%u)\n", ROBOT_ID, START_X, START_Y);
  checkOwnMac();

  if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW INIT FAILED"); while (true) delay(1000); }
  esp_now_register_recv_cb(onDataRecv);
  if (!addFleetPeers()) { Serial.println("PEER SETUP FAILED"); while (true) delay(1000); }
  Serial.println("==============================================");
  Serial.println("Waiting for a job from ESP-C...");
  broadcastState();
}

void loop() {
  RxItem it;
  while (xQueueReceive(rxQueue, &it, 0) == pdTRUE) handlePacket(it);

  coordinate();

  if (millis() - lastState >= STATE_PERIOD_MS) broadcastState();
  delay(10);
}
