bool fresh(int i) { return rv[i].valid && (millis() - rv[i].lastSeen) < PEER_TIMEOUT_MS; }

void sendRaw(const void* p, size_t n) { esp_now_send(nullptr, (const uint8_t*)p, n); }

void sendControl() {
  ControlMsg m;
  fillHeader(m.h, MSG_CONTROL, STATION_ID, seqNo++);
  m.running = cRunning;
  for (int i = 0; i < 2; i++) {
    m.jobId[i] = cJob[i];  m.gx[i] = cGx[i];  m.gy[i] = cGy[i];
    m.resetId[i] = cReset[i];  m.rx[i] = cRx[i];  m.ry[i] = cRy[i];
  }
  sendRaw(&m, sizeof(m));
  lastControl = millis();
}

void snapOf(int i, RobotSnap& r) {
  const StateMsg& s = rv[i].s;
  r.id = 'A' + i;
  r.pos = cellIdx(s.x, s.y);
  r.goal = (s.gx == NONE) ? NONE : cellIdx(s.gx, s.gy);
  r.ver = s.planVer;  r.nonce = s.nonce;
  r.nBlocked = s.nBlocked;  memcpy(r.blocked, s.blocked, s.nBlocked);
  r.planLen = s.planLen;    memcpy(r.plan, s.plan, s.planLen);
}

// TinyML prediction for robot i's remaining plan (same function the robots use for priority)
MlPrediction mlOf(int i) {
  RobotSnap r;
  memset(&r, 0, sizeof(r));
  snapOf(i, r);
  return mlRemaining(r);
}

void printMlLine(const char* indent, const MlPrediction& m) {
  Serial.printf("%sML: ETA %.1f s | risk %s %.0f%% | expected %.1f s  "
                "(%u cells, %u segments, %u turns, %u U-turns, %u busy-zone cells)\n",
                indent, m.eta, ML_LEVEL_NAME[m.level], m.risk * 100.0f, m.expected,
                m.f.cells, m.f.segments, m.f.turns90, m.f.turns180, m.f.zoneCells);
}

// current (reported) or commanded position of robot i
uint8_t posOf(int i) {
  if (rv[i].valid && rv[i].s.resetId == cReset[i]) return cellIdx(rv[i].s.x, rv[i].s.y);
  return cellIdx(cRx[i], cRy[i]);      // start just commanded, robot hasn't applied it yet
}

void printMap() {
  char g[GRID_SIZE][GRID_SIZE];
  for (int y = 0; y < GRID_SIZE; y++)
    for (int x = 0; x < GRID_SIZE; x++) g[y][x] = GRID_MAP[y][x] ? '#' : '.';
  for (int i = 0; i < 2; i++) {
    if (!rv[i].valid) continue;
    const StateMsg& s = rv[i].s;
    for (int k = 0; k < s.planLen; k++) {
      char& c = g[cellY(s.plan[k])][cellX(s.plan[k])];
      if (c == '.') c = 'a' + i;
    }
    if (s.gx != NONE && g[s.gy][s.gx] != 'A' && g[s.gy][s.gx] != 'B') g[s.gy][s.gx] = '1' + i;
    for (int k = 0; k < s.nBlocked; k++) {
      char& c = g[cellY(s.blocked[k])][cellX(s.blocked[k])];
      if (c == '.' || c == 'a' || c == 'b') c = 'x';
    }
  }
  for (int i = 0; i < 2; i++) if (rv[i].valid) g[rv[i].s.y][rv[i].s.x] = 'A' + i;

  Serial.println("        x: 0 1 2 3 4");
  for (int y = 0; y < GRID_SIZE; y++) {
    Serial.printf("     y=%d   ", y);
    for (int x = 0; x < GRID_SIZE; x++) Serial.printf("%c ", g[y][x]);
    Serial.println();
  }
  Serial.println("  A/B robot  a/b path  1/2 goal of A/B  x collision cell (obstacle)  # shelf");
}

void printStatus() {
  Serial.println();
  Serial.printf("---- STATUS  (%s) ----\n", cRunning ? "RUNNING" : "STOPPED - type GO to move");
  for (int i = 0; i < 2; i++) {
    char id = 'A' + i;
    if (!rv[i].valid) { Serial.printf("  Robot %c: not heard yet\n", id); continue; }
    const StateMsg& s = rv[i].s;
    Serial.printf("  Robot %c: at (%u,%u)  goal ", id, s.x, s.y);
    if (s.gx == NONE) Serial.print("none ");
    else Serial.printf("(%u,%u) ", s.gx, s.gy);
    Serial.printf(" step %u  plan v%u  %u step(s) left  %s%s%s\n", s.step, s.planVer, s.planLen,
                  s.arrived ? "ARRIVED " : "", s.ready ? "ready" : "checking",
                  fresh(i) ? "" : "  (OFFLINE)");
    if (s.gx != NONE && s.planLen > 0) printMlLine("           ", mlOf(i));
  }
  printMap();
  Serial.printf("  conflicts resolved: %lu (ML decisions: %lu) | real collisions: %lu | untrusted packets: %lu\n",
                (unsigned long)statConflicts, (unsigned long)statMlDecisions,
                (unsigned long)statCollisions, (unsigned long)droppedUnknown);
}

// ML command: both robots' predictions and who would go first right now
void printMl() {
  Serial.println();
  Serial.println("---- TinyML  (ETA = linear regression, risk = logistic regression) ----");
  bool have[2] = {false, false};
  MlPrediction m[2];
  for (int i = 0; i < 2; i++) {
    char id = 'A' + i;
    if (!rv[i].valid) { Serial.printf("  Robot %c: not heard yet\n", id); continue; }
    const StateMsg& s = rv[i].s;
    if (s.gx == NONE || s.planLen == 0) {
      Serial.printf("  Robot %c: %s\n", id, s.arrived ? "arrived - nothing left to predict" : "no job");
      continue;
    }
    m[i] = mlOf(i);
    have[i] = true;
    Serial.printf("  Robot %c: ", id);
    printMlLine("", m[i]);
  }
  if (have[0] && have[1]) {
    char first = (m[0].expected <= m[1].expected) ? 'A' : 'B';
    Serial.printf("  If their paths collide: Robot %c goes first (%.1f s vs %.1f s), Robot %c gives way\n",
                  first, first == 'A' ? m[0].expected : m[1].expected,
                  first == 'A' ? m[1].expected : m[0].expected, first == 'A' ? 'B' : 'A');
  }
  Serial.printf("  delay cost used for expected time: %.1f s | risk thresholds: LOW < %.0f%%, MEDIUM < %.0f%%\n",
                ML_DELAY_COST_S, ML_RISK_LOW_MAX * 100.0f, ML_RISK_MEDIUM_MAX * 100.0f);
}

