// integer hash (was used for the old coin flip; kept for compatibility, unused)
inline uint32_t mix32(uint32_t x) {
  x ^= x >> 16; x *= 0x7FEB352DUL; x ^= x >> 15; x *= 0x846CA68BUL; x ^= x >> 16;
  return x;
}

inline bool inList(const uint8_t* l, uint8_t n, uint8_t c) {
  for (int i = 0; i < n; i++) if (l[i] == c) return true;
  return false;
}

// ---------------- A* : shortest 4-connected path ----------------
// blocked[] cells are walls (start and goal are never blocked).
// out[t-1] = cell at step t; outLen = number of steps.
inline bool planAStar(uint8_t start, uint8_t goal, const uint8_t* blocked, uint8_t nBlocked,
                      uint8_t* out, uint8_t& outLen) {
  const int N = GRID_SIZE * GRID_SIZE;
  uint16_t g[N], f[N];
  int8_t   parent[N];
  bool     open[N], closed[N];
  for (int i = 0; i < N; i++) { g[i] = 0xFFFF; f[i] = 0xFFFF; parent[i] = -1; open[i] = false; closed[i] = false; }

  int gx = cellX(goal), gy = cellY(goal);
  g[start] = 0;
  f[start] = manhattan(cellX(start), cellY(start), gx, gy);
  open[start] = true;

  const int dx[4] = {1, -1, 0, 0};
  const int dy[4] = {0, 0, 1, -1};

  while (true) {
    int best = -1;
    uint16_t bf = 0xFFFF;
    for (int i = 0; i < N; i++)
      if (open[i] && !closed[i] && f[i] < bf) { bf = f[i]; best = i; }
    if (best < 0) return false;
    if (best == goal) break;
    closed[best] = true;

    int bx = cellX(best), by = cellY(best);
    for (int k = 0; k < 4; k++) {
      int nx = bx + dx[k], ny = by + dy[k];
      if (!isFree(nx, ny)) continue;
      int n = cellIdx(nx, ny);
      if (closed[n]) continue;
      if (n != goal && inList(blocked, nBlocked, n)) continue;
      uint16_t ng = g[best] + 1;
      if (!open[n] || ng < g[n]) {
        g[n] = ng;
        f[n] = ng + manhattan(nx, ny, gx, gy);
        parent[n] = best;
        open[n] = true;
      }
    }
  }

  uint8_t rev[N];
  int len = 0;
  for (int c = goal; c != start; c = parent[c]) {
    if (len >= N || parent[c] < 0) return false;
    rev[len++] = c;
  }
  if (len > MAX_PLAN) return false;
  outLen = len;
  for (int i = 0; i < len; i++) out[i] = rev[len - 1 - i];
  return true;
}

// where robot r is at step t (t = 0 -> now); after its plan ends it stays put
inline uint8_t cellAt(const RobotSnap& r, int t) {
  if (t <= 0 || r.planLen == 0) return r.pos;
  if (t - 1 < r.planLen) return r.plan[t - 1];
  return r.plan[r.planLen - 1];
}

// First future collision between two plans, stepping through time together.
//   SAME CELL : both in one cell at step t
//   SWAP      : they exchange cells between t-1 and t (head-on)
//   TAILGATE  : one enters the cell the other is only just leaving
inline bool detectConflict(const RobotSnap& a, const RobotSnap& b, Conflict& c) {
  int T = (a.planLen > b.planLen ? a.planLen : b.planLen) + 1;
  for (int t = 1; t <= T; t++) {
    uint8_t a0 = cellAt(a, t - 1), a1 = cellAt(a, t);
    uint8_t b0 = cellAt(b, t - 1), b1 = cellAt(b, t);
    uint8_t type = CT_NONE;
    if (a1 == b1)                    type = CT_VERTEX;
    else if (a1 == b0 && b1 == a0)   type = CT_SWAP;
    else if (a1 == b0 || b1 == a0)   type = CT_FOLLOW;
    if (type != CT_NONE) { c.type = type; c.t = t; c.cellA = a1; c.cellB = b1; return true; }
  }
  return false;
}

// Replan robot r with 'cell' added as an obstacle. Not allowed on its own
// position or goal (that could never be avoided).
inline bool tryBlock(const RobotSnap& r, uint8_t cell, uint8_t* out, uint8_t& len) {
  if (r.goal == NONE || cell == r.pos || cell == r.goal || r.nBlocked >= MAX_BLOCKED) return false;
  uint8_t bl[MAX_BLOCKED];
  memcpy(bl, r.blocked, r.nBlocked);
  bl[r.nBlocked] = cell;
  return planAStar(r.pos, r.goal, bl, r.nBlocked + 1, out, len);
}

inline bool canWait(const RobotSnap& r) { return r.goal != NONE && r.planLen > 0 && r.planLen < MAX_PLAN; }

// Used when the collision cell can't be made an obstacle (e.g. two adjacent robots
// that want to swap places: each one's collision cell is its own goal).
// Robot r steps into a free neighbour the other robot isn't using, and plans its
// way back to its goal AROUND the other robot's remaining route and parking cell.
inline bool trySidestep(const RobotSnap& r, const RobotSnap& other, uint8_t* out, uint8_t& len) {
  const int dx[4] = {1, -1, 0, 0};
  const int dy[4] = {0, 0, 1, -1};
  uint8_t o0 = cellAt(other, 0), o1 = cellAt(other, 1);

  // cells to keep clear on the way back: other robot's position, route and final cell
  uint8_t avoid[MAX_BLOCKED + MAX_PLAN + 1];
  uint8_t na = 0;
  for (int i = 0; i < r.nBlocked; i++) avoid[na++] = r.blocked[i];
  avoid[na++] = other.pos;
  for (int t = 0; t < other.planLen; t++) avoid[na++] = other.plan[t];

  int best = -1, bestScore = 9999;
  uint8_t bestRest[MAX_PLAN], bestLen = 0;
  for (int k = 0; k < 4; k++) {
    int nx = cellX(r.pos) + dx[k], ny = cellY(r.pos) + dy[k];
    if (!isFree(nx, ny)) continue;
    uint8_t n = cellIdx(nx, ny);
    if (n == o0 || n == o1) continue;
    int score = 0;
    uint8_t rest[MAX_PLAN], rl = 0;
    if (r.goal != NONE && n != r.goal) {
      if (!planAStar(n, r.goal, avoid, na, rest, rl) &&            // around the other robot
          !planAStar(n, r.goal, r.blocked, r.nBlocked, rest, rl))  // any route at all
        continue;
      score = rl;
    }
    for (int t = 0; t < other.planLen; t++) if (other.plan[t] == n) { score += 10; break; }
    if (score < bestScore && rl + 1 <= MAX_PLAN) {
      bestScore = score; best = n; bestLen = rl; memcpy(bestRest, rest, rl);
    }
  }
  if (best < 0) return false;
  out[0] = best;
  memcpy(out + 1, bestRest, bestLen);
  len = 1 + bestLen;
  return true;
}

// ---------------------------------------------------------------------
// TINYML : ETA + DELAY-RISK MODELS  (trained in Gazebo, 146 trips)
//   ETA  = linear regression (median fit)      -> seconds of driving
//   RISK = logistic regression (gradient descent) -> chance of a delay
//   expected time = ETA + risk x average delay
// Values come from ~/amr_ws/data/models.h on the laptop. After every
// retrain, copy the new numbers into this block (same block in ESP-B).
// ---------------------------------------------------------------------

// ---- ETA model: learned from data (test error 0.28 s, 95% within 1 s) ----
#define ML_ETA_BIAS          -0.20f     // fixed cost per trip
#define ML_ETA_W_CELLS        1.35f     // per cell driven
#define ML_ETA_W_SEGMENTS     0.93f     // per straight segment (start + stop)
#define ML_ETA_W_TURN90       2.11f     // per 90-degree turn
#define ML_ETA_W_TURN180      3.46f     // per U-turn

// ---- hand-written formula (the risk model uses it as "exposure") ----
#define ML_F_SEGMENT          0.70f
#define ML_F_CELL             1.35f
#define ML_F_TURN90           2.10f
#define ML_F_TURN180          3.40f

// ---- RISK model: logistic regression on standardised features ----
// Weights are the trained values. BIAS, MEAN_* and STD_* below are ESTIMATES:
// replace them with the exact numbers from predictRisk() in models.h.
#define ML_RISK_BIAS         -1.40f     // ESTIMATE - replace from models.h
#define ML_RISK_W_EXPOSURE    1.08f     // longer trips  -> more risk
#define ML_RISK_W_NEAR       -0.26f     // obstacles near route (planned around)
#define ML_RISK_W_ZONE        0.26f     // cells in the busy zone -> more risk
#define ML_RISK_MEAN_EXPOSURE 13.0f     // ESTIMATE - replace from models.h
#define ML_RISK_STD_EXPOSURE   5.0f     // ESTIMATE - replace from models.h
#define ML_RISK_MEAN_NEAR      1.5f     // ESTIMATE - replace from models.h
#define ML_RISK_STD_NEAR       1.5f     // ESTIMATE - replace from models.h
#define ML_RISK_MEAN_ZONE      1.5f     // ESTIMATE - replace from models.h
#define ML_RISK_STD_ZONE       2.0f     // ESTIMATE - replace from models.h
#define ML_RISK_LOW_MAX        0.17f    // below = LOW    (thresholds in risk_model.json)
#define ML_RISK_MEDIUM_MAX     0.30f    // below = MEDIUM, else HIGH
#define ML_DELAY_COST_S       11.7f     // delayed trips were 11.7 s slower on average

// ---- busy zone on this 5x5 grid (like the packing area in Gazebo) ----
#define ML_ZONE_X0 1
#define ML_ZONE_X1 3
#define ML_ZONE_Y0 2
#define ML_ZONE_Y1 3

static const char* const ML_LEVEL_NAME[3] = {"LOW", "MEDIUM", "HIGH"};

inline bool mlInZone(uint8_t c) {
  uint8_t x = cellX(c), y = cellY(c);
  return x >= ML_ZONE_X0 && x <= ML_ZONE_X1 && y >= ML_ZONE_Y0 && y <= ML_ZONE_Y1;
}

// direction of a one-cell move: 0 = +Y, 1 = +X, 2 = -Y, 3 = -X, NONE = not a move
inline uint8_t mlDir(uint8_t from, uint8_t to) {
  int dx = (int)cellX(to) - (int)cellX(from);
  int dy = (int)cellY(to) - (int)cellY(from);
  if (dx == 0 && dy == 1)  return 0;
  if (dx == 1 && dy == 0)  return 1;
  if (dx == 0 && dy == -1) return 2;
  if (dx == -1 && dy == 0) return 3;
  return NONE;
}

// Same features as features.py in Gazebo: counted from the robot's position
// and heading along its plan. A wait (repeated cell) ends the current segment.
inline MlFeatures mlExtract(uint8_t start, uint8_t head, const uint8_t* p, uint8_t n) {
  MlFeatures f;
  memset(&f, 0, sizeof(f));
  uint8_t prev = start, h = head;
  bool inRun = false;
  bool near[GRID_SIZE * GRID_SIZE];
  memset(near, 0, sizeof(near));

  for (int i = -1; i < (int)n; i++) {
    uint8_t c = (i < 0) ? start : p[i];
    // obstacles (shelves) touching this route cell, 8-neighbourhood, counted once
    for (int dx = -1; dx <= 1; dx++)
      for (int dy = -1; dy <= 1; dy++) {
        int nx = (int)cellX(c) + dx, ny = (int)cellY(c) + dy;
        if (inGrid(nx, ny) && GRID_MAP[ny][nx] == 1) near[cellIdx(nx, ny)] = true;
      }
    if (i < 0) continue;

    if (c == prev) { inRun = false; continue; }         // wait step
    uint8_t d = mlDir(prev, c);
    if (d == NONE) { inRun = false; prev = c; continue; }
    if (d != h) {
      uint8_t diff = (uint8_t)((d + 4 - h) % 4);
      if (diff == 2) f.turns180++;
      else           f.turns90++;
      h = d;
      inRun = false;
    }
    if (!inRun) { f.segments++; inRun = true; }
    f.cells++;
    if (mlInZone(c)) f.zoneCells++;
    prev = c;
  }
  for (int i = 0; i < GRID_SIZE * GRID_SIZE; i++) if (near[i]) f.nearPath++;
  return f;
}

inline float mlEta(const MlFeatures& f) {
  float t = ML_ETA_BIAS + ML_ETA_W_CELLS * f.cells + ML_ETA_W_SEGMENTS * f.segments +
            ML_ETA_W_TURN90 * f.turns90 + ML_ETA_W_TURN180 * f.turns180;
  return t > 0.0f ? t : 0.0f;
}

inline float mlEtaFormula(const MlFeatures& f) {
  return ML_F_SEGMENT * f.segments + ML_F_CELL * f.cells +
         ML_F_TURN90 * f.turns90 + ML_F_TURN180 * f.turns180;
}

inline float mlRisk(float exposure, const MlFeatures& f) {
  float z = ML_RISK_BIAS
          + ML_RISK_W_EXPOSURE * (exposure - ML_RISK_MEAN_EXPOSURE) / ML_RISK_STD_EXPOSURE
          + ML_RISK_W_NEAR * ((float)f.nearPath - ML_RISK_MEAN_NEAR) / ML_RISK_STD_NEAR
          + ML_RISK_W_ZONE * ((float)f.zoneCells - ML_RISK_MEAN_ZONE) / ML_RISK_STD_ZONE;
  return 1.0f / (1.0f + expf(-z));
}

inline MlPrediction mlPredict(uint8_t start, uint8_t head, const uint8_t* p, uint8_t n) {
  MlPrediction m;
  memset(&m, 0, sizeof(m));
  m.f = mlExtract(start, head, p, n);
  m.eta = mlEta(m.f);
  m.etaFormula = mlEtaFormula(m.f);
  m.risk = (m.f.cells > 0) ? mlRisk(m.etaFormula, m.f) : 0.0f;
  m.level = (m.risk < ML_RISK_LOW_MAX) ? 0 : (m.risk < ML_RISK_MEDIUM_MAX ? 1 : 2);
  m.expected = m.eta + m.risk * ML_DELAY_COST_S;
  m.scheduleS = n * (STEP_MS / 1000.0f);
  m.valid = true;
  return m;
}

// Collision priority: each robot's expected REMAINING time, computed only
// from data both robots share (position + plan), so both get the same number.
// The heading is not shared, so the first move is taken as straight ahead
// (same assumption for both robots). An idle robot scores 0 (nothing to finish).
inline MlPrediction mlRemaining(const RobotSnap& r) {
  MlPrediction m;
  memset(&m, 0, sizeof(m));
  if (r.goal == NONE || r.planLen == 0) return m;
  uint8_t head = NONE;
  uint8_t prev = r.pos;
  for (int i = 0; i < r.planLen && head == NONE; i++) {
    head = mlDir(prev, r.plan[i]);
    prev = r.plan[i];
  }
  if (head == NONE) head = 0;
  return mlPredict(r.pos, head, r.plan, r.planLen);
}

// Who fixes the conflict, and how - decided by the TinyML models:
//   0. TAILGATE: the follower waits 1 step (it is simply too close behind).
//   1. Both robots predict each robot's expected REMAINING time
//      (ML ETA + risk x average delay). The robot that finishes SOONER goes
//      first; the other one YIELDS. Tie (within 0.1 s): the lower-risk trip
//      goes first; still tied: Robot A goes first.
//   2. The yielding robot treats its collision cell as an OBSTACLE and
//      replans (A*). If it can't (cell is its own start/goal, or no route),
//      the other robot tries.
//   3. If neither can (e.g. adjacent robots swapping places), the yielding
//      robot steps aside into a free neighbour cell, then replans.
//   4. Last resort: the yielding robot waits 1 step.
// Pure function of shared data -> both robots always reach the same decision.
inline Resolution chooseResolution(const Conflict& c, const RobotSnap& a, const RobotSnap& b) {
  Resolution r;
  memset(&r, 0, sizeof(r));
  r.action = ACT_NONE; r.cell = NONE; r.why = WHY_ML_TIME;

  MlPrediction pa = mlRemaining(a);
  MlPrediction pb = mlRemaining(b);
  r.expA = pa.expected;
  r.expB = pb.expected;

  if (c.type == CT_FOLLOW) {
    bool aFollows = (cellAt(a, c.t) == cellAt(b, c.t - 1));
    const RobotSnap& fol = aFollows ? a : b;
    if (canWait(fol)) {
      r.robot = fol.id; r.action = ACT_WAIT; r.why = WHY_TAILGATE;
      r.coin = aFollows ? 0 : 1;
      return r;
    }
  }

  // who yields? (true -> A yields, B goes first)
  bool aYields;
  if (pa.expected > pb.expected + 0.1f)      { aYields = true;  r.why = WHY_ML_TIME; }
  else if (pb.expected > pa.expected + 0.1f) { aYields = false; r.why = WHY_ML_TIME; }
  else if (pa.risk > pb.risk + 0.001f)       { aYields = true;  r.why = WHY_ML_RISK; }
  else if (pb.risk > pa.risk + 0.001f)       { aYields = false; r.why = WHY_ML_RISK; }
  else                                       { aYields = false; r.why = WHY_TIE_ID; }
  r.coin = aYields ? 0 : 1;                  // same meaning as before: who is picked first

  const RobotSnap* order[2] = { aYields ? &a : &b, aYields ? &b : &a };
  uint8_t tmp[MAX_PLAN];
  uint8_t len = 0;
  for (int i = 0; i < 2; i++) {
    uint8_t cell = (order[i] == &a) ? c.cellA : c.cellB;
    if (tryBlock(*order[i], cell, tmp, len)) {
      r.robot = order[i]->id; r.action = ACT_BLOCK; r.cell = cell;
      return r;
    }
  }
  for (int i = 0; i < 2; i++) {
    const RobotSnap& oth = (order[i] == &a) ? b : a;
    if (trySidestep(*order[i], oth, tmp, len)) {
      r.robot = order[i]->id; r.action = ACT_SIDESTEP; r.cell = tmp[0];
      return r;
    }
  }
  for (int i = 0; i < 2; i++)
    if (canWait(*order[i])) { r.robot = order[i]->id; r.action = ACT_WAIT; return r; }
  return r;                                         // nothing possible -> reported as STUCK
}

inline const char* whyName(uint8_t w) {
  static const char* n[] = {"ML: longer expected time yields", "ML: equal time, higher risk yields",
                            "ML: exact tie, Robot A goes first", "tailgate: follower waits"};
  return w < 4 ? n[w] : "?";
}

