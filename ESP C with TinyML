bool validCell(int x, int y, const char* what) {
  if (!inGrid(x, y)) { Serial.printf("[ERROR] %s (%d,%d) is outside the %dx%d grid\n", what, x, y, GRID_SIZE, GRID_SIZE); return false; }
  if (!isFree(x, y)) { Serial.printf("[ERROR] %s (%d,%d) is an obstacle\n", what, x, y); return false; }
  return true;
}

// start given only if hasStart
bool setJob(int i, bool hasStart, int sx, int sy, int gx, int gy) {
  char id = 'A' + i;
  int o = 1 - i;
  if (hasStart) {
    if (cRunning) { Serial.println("[ERROR] type STOP before changing start positions"); return false; }
    if (!validCell(sx, sy, "start")) return false;
    uint8_t otherPos = posOf(o);
    if (cellIdx(sx, sy) == otherPos) {
      Serial.printf("[ERROR] start (%d,%d) is where Robot %c is standing\n", sx, sy, 'A' + o);
      return false;
    }
  }
  if (!validCell(gx, gy, "goal")) return false;
  if (cGx[o] != NONE && cGx[o] == gx && cGy[o] == gy) {
    Serial.printf("[ERROR] goal (%d,%d) is already Robot %c's goal - two robots can't end in one cell\n",
                  gx, gy, 'A' + o);
    return false;
  }
  if (hasStart) { cReset[i]++; cRx[i] = sx; cRy[i] = sy; }
  cJob[i]++;
  if (cJob[i] == 0) cJob[i] = 1;
  cGx[i] = gx;  cGy[i] = gy;
  missionDone = false;
  lastCheckKey = 0xFFFF;

  Serial.println();
  Serial.printf("[JOB] Robot %c: ", id);
  if (hasStart) Serial.printf("start (%d,%d) -> ", sx, sy);
  else { Serial.print("from current cell ");  printCellC(posOf(i));  Serial.print(" -> "); }
  Serial.printf("goal (%d,%d)   sent to ESP-%c\n", gx, gy, id);
  sendControl();
  return true;
}

void doReset() {
  cRunning = 0;
  for (int i = 0; i < 2; i++) { cReset[i]++; cJob[i]++; if (!cJob[i]) cJob[i] = 1; cGx[i] = NONE; cGy[i] = NONE; }
  cRx[0] = A_START_X; cRy[0] = A_START_Y; cRx[1] = B_START_X; cRy[1] = B_START_Y;
  missionDone = true;
  lastGridStep = 0;
  Serial.println("\n[RESET] robots -> A(0,0)  B(4,4), jobs cleared, STOPPED");
  sendControl();
}

void runDemo(int n) {
  cRunning = 0;
  cGx[0] = cGx[1] = NONE;                          // avoid "same goal" rejection between demos
  // move both starts out of each other's way first
  int s[4][8] = {
    {0, 0, 4, 0,   4, 0, 0, 0},                    // DEMO1 head-on in row 0
    {0, 2, 4, 2,   2, 0, 2, 4},                    // DEMO2 crossing at (2,2)
    {0, 0, 4, 4,   4, 4, 0, 0},                    // DEMO3 opposite corners
    {0, 1, 4, 1,   2, 3, 2, 0},                    // DEMO4 A long trip vs B short trip, meet at (2,1)
  };
  int* d = s[n - 1];
  cReset[0]++; cRx[0] = d[0]; cRy[0] = d[1];
  cReset[1]++; cRx[1] = d[4]; cRy[1] = d[5];
  cJob[0]++; if (!cJob[0]) cJob[0] = 1; cGx[0] = d[2]; cGy[0] = d[3];
  cJob[1]++; if (!cJob[1]) cJob[1] = 1; cGx[1] = d[6]; cGy[1] = d[7];
  missionDone = false;
  lastCheckKey = 0xFFFF;
  lastGridStep = 0;
  Serial.printf("\n[DEMO%d] Robot A (%d,%d)->(%d,%d)   Robot B (%d,%d)->(%d,%d)\n",
                n, d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
  if (n == 4)
    Serial.println("        A has the longer trip -> the ML should make A give way at (2,1)");
  Serial.println("        watch the plans + collision handling below, then type GO");
  sendControl();
}

// Parses every "A/B + 2 or 4 numbers" group on the line, plus an optional GO at the end
void processJobLine(char* line) {
  for (char* p = line; *p; p++) if (*p == ',' || *p == ';' || *p == '(' || *p == ')') *p = ' ';

  char* tok[24];
  int nt = 0;
  for (char* t = strtok(line, " \t"); t && nt < 24; t = strtok(nullptr, " \t")) tok[nt++] = t;

  bool go = false;
  int jobs = 0;
  int k = 0;
  while (k < nt) {
    if (!strcmp(tok[k], "GO")) { go = true; k++; continue; }
    if (strcmp(tok[k], "A") && strcmp(tok[k], "B")) {
      Serial.printf("[ERROR] expected A or B, got \"%s\"\n", tok[k]);
      return;
    }
    int i = tok[k][0] - 'A';
    int v[4], n = 0;
    k++;
    while (k < nt && n < 4 && (isdigit((unsigned char)tok[k][0]) || tok[k][0] == '-')) v[n++] = atoi(tok[k++]);
    if (n == 2)      { if (!setJob(i, false, 0, 0, v[0], v[1])) return; }
    else if (n == 4) { if (!setJob(i, true, v[0], v[1], v[2], v[3])) return; }
    else { Serial.printf("[ERROR] Robot %c needs 2 numbers (goal) or 4 (start + goal)\n", 'A' + i); return; }
    jobs++;
  }
  if (jobs == 2) Serial.println("[JOB] both jobs sent together - robots plan and check each other now");
  if (go) {
    cRunning = 1;
    lastGridStep = 0;
    Serial.println("\n[GO] robots move one synchronized step at a time, only on collision-free plans");
    sendControl();
  } else if (jobs) {
    Serial.println("      type GO when the [CHECK] line says NO COLLISION");
  }
}

void processCommand(char* line) {
  for (char* p = line; *p; p++) *p = toupper(*p);
  while (*line == ' ') line++;
  if (!*line) return;

  if (!strcmp(line, "GO")) {
    cRunning = 1;
    lastGridStep = 0;
    Serial.println("\n[GO] robots move one synchronized step at a time, only on collision-free plans");
    sendControl();
    return;
  }
  if (!strcmp(line, "STOP"))   { cRunning = 0; Serial.println("\n[STOP] movement paused"); sendControl(); return; }
  if (!strcmp(line, "RESET"))  { doReset(); return; }
  if (!strcmp(line, "STATUS") || !strcmp(line, "MAP") || !strcmp(line, "M")) { printStatus(); return; }
  if (!strcmp(line, "HELP") || !strcmp(line, "H") || !strcmp(line, "?")) { printHelp(); return; }
  if (!strcmp(line, "ML"))    { printMl(); return; }
  if (!strcmp(line, "DEMO1")) { runDemo(1); return; }
  if (!strcmp(line, "DEMO2")) { runDemo(2); return; }
  if (!strcmp(line, "DEMO3")) { runDemo(3); return; }
  if (!strcmp(line, "DEMO4")) { runDemo(4); return; }

  // One or more jobs on one line, e.g.  "A 0 0 4 0 B 4 0 0 0"  or  "A 4 0 B 0 0 GO"
  if (line[0] == 'A' || line[0] == 'B') { processJobLine(line); return; }
  Serial.printf("[ERROR] unknown command \"%s\" - type HELP\n", line);
}

void handleSerial() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == '\n' || ch == '\r') {
      lineBuf[lineLen] = 0;
      if (lineLen) processCommand(lineBuf);
      lineLen = 0;
    } else if (lineLen < sizeof(lineBuf) - 1) {
      lineBuf[lineLen++] = ch;
    }
  }
}

