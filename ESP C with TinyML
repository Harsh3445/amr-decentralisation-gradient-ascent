};

// Robot -> everyone, every 200 ms and on every change
struct __attribute__((packed)) StateMsg {
  MsgHeader h;
  uint8_t  x, y;                // current cell
  uint8_t  gx, gy;              // goal (NONE = no job)
  uint8_t  jobId, resetId;      // last job / reset applied from ESP-C
  uint8_t  arrived;             // 1 = at goal, plan finished
  uint16_t step;                // synchronized step counter
  uint8_t  planVer;             // +1 on every new plan
  uint8_t  seenPeerVer;         // latest plan version I have from the other robot
  uint8_t  ready;               // 1 = my plan vs peer plan checked conflict-free at this step
  uint8_t  readyMyVer;          //     ...for my plan version
  uint8_t  readyPeerVer;        //     ...and the peer's plan version
  uint8_t  running;             // GO received
  uint8_t  planReason;          // why the last plan was made
  uint8_t  reasonCell;          // cell involved (e.g. the collision cell now an obstacle)
  uint32_t nonce;               // random per boot -> shared coin flip
  uint8_t  nBlocked;            // collision cells I treat as obstacles
  uint8_t  blocked[MAX_BLOCKED];
  uint8_t  planLen;             // plan[t-1] = my cell at step t (repeat = wait)
  uint8_t  plan[MAX_PLAN];
};

