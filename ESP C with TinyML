void printPlan(int i) {
  const StateMsg& s = rv[i].s;
  char id = 'A' + i;
  if (s.gx == NONE && s.planLen == 0) return;
  Serial.println();
  Serial.printf("[PLAN] Robot %c  plan v%u  (%s", id, s.planVer, reasonName(s.planReason));
  if (s.planReason == PR_AVOID_CELL) { Serial.print(" "); printCellC(s.reasonCell); }
  Serial.println(")");
  Serial.print("       ");
  printCellC(cellIdx(s.x, s.y));
  for (int k = 0; k < s.planLen; k++) { Serial.print(" -> "); printCellC(s.plan[k]); }
  Serial.printf("   = %u step(s)\n", s.planLen);
  if (s.nBlocked) {
    Serial.print("       collision cells treated as obstacles: ");
    for (int k = 0; k < s.nBlocked; k++) { printCellC(s.blocked[k]); Serial.print(" "); }
    Serial.println();
  }
  if (s.gx != NONE && s.planLen > 0) {
    MlPrediction m = mlOf(i);
    printMlLine("       ", m);
    // remember the first prediction of each job for the MISSION COMPLETE summary
    if (!jobMl[i].valid || jobMl[i].jobId != s.jobId) {
      jobMl[i].valid = true;
      jobMl[i].jobId = s.jobId;
      jobMl[i].first = m;
      jobMl[i].startStep = s.step;
    }
  }
}

// ESP-C re-runs the same collision check itself as an independent verification
void crossCheck() {
  if (!fresh(0) || !fresh(1)) return;
  const StateMsg& a = rv[0].s;
  const StateMsg& b = rv[1].s;
  if (a.step != b.step || a.seenPeerVer != b.planVer || b.seenPeerVer != a.planVer) return;
  uint16_t key = ((uint16_t)a.planVer << 8) | b.planVer;
  if (key == lastCheckKey) return;
  RobotSnap sa, sb;
  snapOf(0, sa);
  snapOf(1, sb);
  Conflict c;
  if (detectConflict(sa, sb, c)) return;           // robots are still resolving it
  lastCheckKey = key;
  if (a.planLen == 0 && b.planLen == 0) return;
  Serial.printf("\n[CHECK] ESP-C verified plans A v%u + B v%u: NO COLLISION at any step", a.planVer, b.planVer);
  Serial.println(cRunning ? "" : "  -> type GO");
}

void onEvent(const EventMsg& e) {
  char who = e.h.sender;
  if (e.ev == EV_CONFLICT) {
    statConflicts++;
    Serial.println();
    Serial.printf("[COLLISION PREDICTED] %s in %u step(s): Robot A would be at ", conflictName(e.ctype), e.t);
    printCellC(e.cellA);  Serial.print(", Robot B at ");  printCellC(e.cellB);  Serial.println();

    // The robots decided with the TinyML priority. 'coin' tells us which robot the
    // ML picked to give way (0 = A, 1 = B). ESP-C recomputes the numbers itself.
    char picked = e.coin ? 'B' : 'A';
    if (e.ctype != CT_FOLLOW) {
      statMlDecisions++;
      if (rv[0].valid && rv[1].valid) {
        RobotSnap sa, sb;
        snapOf(0, sa);
        snapOf(1, sb);
        Conflict c;
        c.type = e.ctype;  c.t = e.t;  c.cellA = e.cellA;  c.cellB = e.cellB;
        Resolution mine = chooseResolution(c, sa, sb);
        Serial.printf("   ML priority: Robot A expected %.1f s, Robot B expected %.1f s -> %s\n",
                      mine.expA, mine.expB, whyName(mine.why));
        if (mine.robot != e.resolver || mine.action != e.action)
          Serial.println("   (ESP-C computed this from the plans it heard; the robots decided on their latest plans)");
      }
      Serial.printf("   -> Robot %c gives way, Robot %c keeps its route\n", picked, picked == 'A' ? 'B' : 'A');
    }

    if (e.action == ACT_BLOCK) {
      if (e.resolver != picked)
        Serial.printf("   Robot %c cannot avoid that cell (its own start/goal) -> Robot %c reroutes instead\n",
                      picked, e.resolver);
      Serial.printf("   Robot %c treats ", e.resolver);
      printCellC(e.blockCell);
      Serial.println(" as an OBSTACLE and replans");
    } else if (e.action == ACT_SIDESTEP) {
      Serial.printf("   neither robot can avoid its collision cell (it is its own start/goal)\n");
      Serial.printf("   -> Robot %c steps aside to ", e.resolver);
      printCellC(e.blockCell);
      Serial.println(" to make way, then replans");
    } else if (e.action == ACT_WAIT) {
      if (e.ctype == CT_FOLLOW) Serial.printf("   Robot %c is the follower -> waits 1 step\n", e.resolver);
      else                      Serial.printf("   no detour possible -> Robot %c waits 1 step\n", e.resolver);
    }
  } else if (e.ev == EV_ARRIVED) {
    rv[who - 'A'].arrivedStep = e.step;
    Serial.printf("\n[ARRIVED] Robot %c reached its goal (%u,%u) at step %u\n", who, e.x, e.y, e.step);
  } else if (e.ev == EV_NO_PATH) {
    Serial.printf("\n[ERROR] Robot %c: no path from (%u,%u) to its goal\n", who, e.x, e.y);
  } else if (e.ev == EV_STUCK) {
    Serial.printf("\n[STUCK] conflict %s cannot be resolved by rerouting or waiting - change a goal\n",
                  conflictName(e.ctype));
  }
}

void checkMission() {
  if (missionDone) return;
  bool any = false;
  for (int i = 0; i < 2; i++) {
    if (cGx[i] == NONE) continue;
    any = true;
    if (!rv[i].valid) return;
    const StateMsg& s = rv[i].s;
    if (s.jobId != cJob[i] || !s.arrived) return;
  }
  if (!any) return;
  missionDone = true;
  cRunning = 0;
  sendControl();
  Serial.println();
  Serial.println("==================================================================");
  Serial.println("  MISSION COMPLETE - all robots reached their goals");
  for (int i = 0; i < 2; i++) {
    if (cGx[i] == NONE) continue;
    Serial.printf("    Robot %c: goal (%u,%u) reached at step %u\n", 'A' + i, cGx[i], cGy[i], rv[i].arrivedStep);
    if (jobMl[i].valid && jobMl[i].jobId == cJob[i]) {
      const MlPrediction& m = jobMl[i].first;
      Serial.printf("             TinyML at job start: ETA %.1f s, risk %s %.0f%%, expected %.1f s | took %u steps\n",
                    m.eta, ML_LEVEL_NAME[m.level], m.risk * 100.0f, m.expected,
                    (unsigned)(rv[i].arrivedStep - jobMl[i].startStep));
    }
  }
  Serial.printf("    collisions predicted & resolved: %lu (ML priority decisions: %lu) | real collisions: %lu\n",
                (unsigned long)statConflicts, (unsigned long)statMlDecisions, (unsigned long)statCollisions);
  Serial.println("  (auto-STOP) enter new jobs, DEMO1/2/3/4, or RESET");
  Serial.println("==================================================================");
  statConflicts = 0;
  statMlDecisions = 0;
}

void onState(const StateMsg& s, const uint8_t* mac) {
  int i = s.h.sender - 'A';
  if (i < 0 || i > 1) return;
  RobotView& r = rv[i];
  bool first = !r.valid;
  uint8_t oldX = r.s.x, oldY = r.s.y;
  uint16_t oldStep = r.s.step;

  r.s = s;  r.valid = true;  r.lastSeen = millis();
  memcpy(r.mac, mac, 6);

  if (first) {
    Serial.printf("[NET] Robot %c online  MAC ", s.h.sender);
    printMacBytes(mac);
    Serial.printf("  at (%u,%u)\n", s.x, s.y);
  }
  if (!r.printedAny || r.printedVer != s.planVer) {
    r.printedAny = true;
    r.printedVer = s.planVer;
    printPlan(i);
  }
  if (!first && s.step != oldStep && cRunning) {
    if (s.x != oldX || s.y != oldY)
      Serial.printf("[STEP %u] Robot %c (%u,%u) -> (%u,%u)\n", s.step, s.h.sender, oldX, oldY, s.x, s.y);
    else if (s.gx != NONE && !s.arrived)
      Serial.printf("[STEP %u] Robot %c waits at (%u,%u)\n", s.step, s.h.sender, s.x, s.y);
  }
  // after both robots finished a step, draw the grid
  if (fresh(0) && fresh(1) && rv[0].s.step == rv[1].s.step && rv[0].s.step > lastGridStep && cRunning) {
    lastGridStep = rv[0].s.step;
    printMap();
  }
  // real collision alarm (should never fire)
  bool same = fresh(0) && fresh(1) && rv[0].s.x == rv[1].s.x && rv[0].s.y == rv[1].s.y;
  if (same && !colliding) {
    statCollisions++;
    Serial.printf("\n!!!!! REAL COLLISION at (%u,%u) !!!!!\n", rv[0].s.x, rv[0].s.y);
  }
  colliding = same;

  crossCheck();
  checkMission();
}

// =====================================================================
// NETWORK
// =====================================================================
void checkOwnMac() {
  // Read the MAC straight from eFuse: works even before the Wi-Fi driver has
  // finished starting (WiFi.macAddress() returns 00:00:.. at that moment)
  uint8_t mine[6] = {0};
  esp_read_mac(mine, ESP_MAC_WIFI_STA);
  Serial.print("  this board MAC : ");  printMacBytes(mine);             Serial.println();
  Serial.print("  expected MAC   : ");  printMacBytes(macOf(STATION_ID)); Serial.println();
  if (memcmp(mine, macOf(STATION_ID), 6) != 0)
    Serial.println("  !!! WARNING: MAC MISMATCH - wrong sketch on this board !!!");
}

bool addFleetPeers() {
  for (int i = 0; i < FLEET_SIZE; i++) {
    if (FLEET[i].id == STATION_ID) continue;
    esp_now_peer_info_t pi = {};
    memcpy(pi.peer_addr, FLEET[i].mac, 6);
    pi.channel = WIFI_CHANNEL;
    pi.encrypt = false;
    if (esp_now_add_peer(&pi) != ESP_OK) return false;
    Serial.print("  peer added     : ");  printMacBytes(FLEET[i].mac);
    Serial.printf("  (%s)\n", FLEET[i].name);
  }
  return true;
}

void handlePacket(const RxItem& it) {
  if (!validHeader(it.data, it.len)) return;
  MsgHeader h;
  memcpy(&h, it.data, sizeof(h));
  char id = idFromMac(it.mac);
  if (id == 0 || id != h.sender) { droppedUnknown++; return; }

  if (h.type == MSG_STATE && it.len == sizeof(StateMsg)) {
    StateMsg s;  memcpy(&s, it.data, sizeof(s));  onState(s, it.mac);
  } else if (h.type == MSG_EVENT && it.len == sizeof(EventMsg)) {
    EventMsg e;  memcpy(&e, it.data, sizeof(e));  onEvent(e);
  }
}

void onDataRecv(const esp_now_recv_info_t* info, const uint8_t* data, int len) {
  if (len <= 0 || len > 250) return;
  RxItem it;
  memcpy(it.mac, info->src_addr, 6);
  it.len = len;
  memcpy(it.data, data, len);
  xQueueSend(rxQueue, &it, 0);
}

// =====================================================================
// SETUP / LOOP
// =====================================================================
void setup() {
  Serial.begin(115200);
  delay(800);
  WiFi.mode(WIFI_STA);
  WiFi.setChannel(WIFI_CHANNEL);
  rxQueue = xQueueCreate(24, sizeof(RxItem));
  memset(rv, 0, sizeof(rv));
  memset(jobMl, 0, sizeof(jobMl));

  Serial.println();
  Serial.println("==============================================");
  Serial.println("  AUTONAV v4 - ESP-C : JOB ENTRY + MONITOR");
  Serial.println("  build v4.3  (TinyML priority: the ML decides who gives way)");
  checkOwnMac();
  if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW INIT FAILED"); while (true) delay(1000); }
  esp_now_register_recv_cb(onDataRecv);
  if (!addFleetPeers()) { Serial.println("PEER SETUP FAILED"); while (true) delay(1000); }
  Serial.println("==============================================");
  printHelp();
  Serial.println("\nType both jobs on one line, e.g.  A 0 0 4 0, B 4 0 0 0   then   GO   (or DEMO4 for the ML demo)");
}

void loop() {
  RxItem it;
  while (xQueueReceive(rxQueue, &it, 0) == pdTRUE) handlePacket(it);
  handleSerial();
  if (millis() - lastControl >= CONTROL_PERIOD_MS) sendControl();
  delay(5);
}
