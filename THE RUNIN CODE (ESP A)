#include <WiFi.h>
#include <esp_now.h>

// =====================================================
// ESP-B MAC ADDRESS
// =====================================================

uint8_t ESP_B_MAC[] = {
  0x20, 0x9B, 0xA9, 0x61, 0xBB, 0x20
};

// =====================================================
// MESSAGE SENT TO ESP-B
// =====================================================

typedef struct {
  char command;
} Message;

Message message;

// =====================================================
// ACK RECEIVED FROM ESP-B
// =====================================================

typedef struct {
  char command;
  long leftTicks;
  long rightTicks;
} AckMessage;

esp_now_peer_info_t peerInfo;

volatile bool ackReceived = false;
volatile char lastAck = 0;

// =====================================================
// CALIBRATION
// =====================================================

// 1 GRID UNIT = 10 CM
const float UNIT_DISTANCE_CM = 10.0;

// 1 GRID UNIT = 333 ms
const float UNIT_TIME_S = 0.3333333;

// 90 DEGREE TURN = 650 ms
const float TURN_90_TIME_S = 0.65;

// =====================================================
// DIRECTIONS
// =====================================================

#define EAST  0
#define NORTH 1
#define WEST  2
#define SOUTH 3

const char *FACING_NAME[4] = {
  "EAST (+X)",
  "NORTH (+Y)",
  "WEST (-X)",
  "SOUTH (-Y)"
};

// =====================================================
// CURRENT ROBOT POSITION
// =====================================================

long currentX = 0;
long currentY = 0;

int currentFacing = EAST;

// =====================================================
// ROUTE
// =====================================================

struct RouteStep {
  char command;
  unsigned long durationMs;
  String label;
};

RouteStep pendingRoute[8];

int pendingRouteLen = 0;

long pendingTargetX;
long pendingTargetY;

int pendingFinalFacing;

bool routeWaitingConfirmation = false;

String inputLine = "";

// =====================================================
// RECEIVE ACK FROM ESP-B
// =====================================================

void onAckReceived(
  const esp_now_recv_info_t *info,
  const uint8_t *data,
  int len
) {

  // Check packet size
  if (len != sizeof(AckMessage)) {
    return;
  }

  AckMessage incoming;

  memcpy(
    &incoming,
    data,
    sizeof(incoming)
  );

  lastAck = incoming.command;
  ackReceived = true;

  // Print encoder data when STOP ACK arrives
  if (incoming.command == 'S') {

    Serial.print("ENCODER TICKS -- Left: ");
    Serial.print(incoming.leftTicks);

    Serial.print("  Right: ");
    Serial.println(incoming.rightTicks);
  }
}

// =====================================================
// SEND COMMAND TO ESP-B
// =====================================================

void sendCommand(char cmd) {

  message.command = cmd;

  esp_now_send(
    ESP_B_MAC,
    (uint8_t *)&message,
    sizeof(message)
  );
}

// =====================================================
// CALCULATE TURN
// =====================================================

int addTurnIfNeeded(
  int currentF,
  int desiredF
) {

  if (currentF == desiredF) {
    return currentF;
  }

  int diffRight =
    ((desiredF - currentF) + 4) % 4;

  char turnCmd;
  int steps;

  if (diffRight <= 2) {

    turnCmd = 'R';
    steps = diffRight;

  } else {

    turnCmd = 'L';
    steps = 4 - diffRight;
  }

  unsigned long durationMs =
    (unsigned long)(
      steps *
      TURN_90_TIME_S *
      1000.0
    );

  String label = "TURN ";

  label +=
    (turnCmd == 'R')
    ? "RIGHT"
    : "LEFT";

  if (steps > 1) {

    label += " x";
    label += steps;
  }

  pendingRoute[pendingRouteLen++] = {
    turnCmd,
    durationMs,
    label
  };

  return desiredF;
}

// =====================================================
// PLAN ROUTE
// =====================================================

void planRoute(
  long targetX,
  long targetY
) {

  long dx = targetX - currentX;
  long dy = targetY - currentY;

  pendingRouteLen = 0;

  int facing = currentFacing;

  Serial.println();
  Serial.println("================ ROUTE PLAN ================");

  Serial.print("FROM: (");
  Serial.print(currentX);
  Serial.print(", ");
  Serial.print(currentY);
  Serial.print(") ");

  Serial.println(
    FACING_NAME[currentFacing]
  );

  Serial.print("TO: (");
  Serial.print(targetX);
  Serial.print(", ");
  Serial.print(targetY);
  Serial.println(")");

  // =================================================
  // X MOVEMENT
  // =================================================

  if (dx != 0) {

    int desiredDirection =
      (dx > 0)
      ? EAST
      : WEST;

    facing =
      addTurnIfNeeded(
        facing,
        desiredDirection
      );

    unsigned long durationMs =
      (unsigned long)(
        abs(dx) *
        UNIT_TIME_S *
        1000.0
      );

    pendingRoute[pendingRouteLen++] = {
      'F',
      durationMs,
      "FORWARD X"
    };
  }

  // =================================================
  // Y MOVEMENT
  // =================================================

  if (dy != 0) {

    int desiredDirection =
      (dy > 0)
      ? NORTH
      : SOUTH;

    facing =
      addTurnIfNeeded(
        facing,
        desiredDirection
      );

    unsigned long durationMs =
      (unsigned long)(
        abs(dy) *
        UNIT_TIME_S *
        1000.0
      );

    pendingRoute[pendingRouteLen++] = {
      'F',
      durationMs,
      "FORWARD Y"
    };
  }

  // =================================================
  // ALREADY AT TARGET
  // =================================================

  if (pendingRouteLen == 0) {

    Serial.println(
      "Already at target."
    );

    return;
  }

  // =================================================
  // DISPLAY ROUTE
  // =================================================

  Serial.println("--------------------------------------------");

  for (
    int i = 0;
    i < pendingRouteLen;
    i++
  ) {

    Serial.print(i + 1);
    Serial.print(") ");

    Serial.print(
      pendingRoute[i].label
    );

    Serial.print(" - ");

    Serial.print(
      pendingRoute[i].durationMs
    );

    Serial.println(" ms");
  }

  pendingTargetX = targetX;
  pendingTargetY = targetY;
  pendingFinalFacing = facing;

  routeWaitingConfirmation = true;

  Serial.println("--------------------------------------------");
  Serial.println("Type OK to execute.");
  Serial.println("Type CANCEL to cancel.");
}

// =====================================================
// RUN ONE MOVEMENT
// =====================================================

void runPulse(
  char cmd,
  unsigned long durationMs
) {

  Serial.println();

  Serial.print("COMMAND: ");
  Serial.println(cmd);

  Serial.print("TIME: ");
  Serial.print(durationMs);
  Serial.println(" ms");

  // Reset ACK
  ackReceived = false;

  // Send movement command
  sendCommand(cmd);

  // Wait for ESP-B confirmation
  unsigned long waitStart = millis();

  while (
    millis() - waitStart < 500 &&
    !ackReceived
  ) {

    delay(2);
  }

  if (ackReceived) {

    Serial.print(
      "ESP-B CONFIRMED: "
    );

    Serial.println(
      (char)lastAck
    );

  } else {

    Serial.println(
      "WARNING: No ACK from ESP-B"
    );
  }

  // Run for calibrated time
  delay(durationMs);

  // STOP
  ackReceived = false;

  sendCommand('S');

  // Give ESP-B time to send encoder count
  delay(300);

  // Gap before next command
  delay(300);
}

// =====================================================
// EXECUTE ROUTE
// =====================================================

void executeRoute() {

  Serial.println();
  Serial.println("========== EXECUTING ==========");

  for (
    int i = 0;
    i < pendingRouteLen;
    i++
  ) {

    Serial.print("STEP ");
    Serial.print(i + 1);
    Serial.print("/");
    Serial.println(pendingRouteLen);

    runPulse(
      pendingRoute[i].command,
      pendingRoute[i].durationMs
    );
  }

  // Update software position
  currentX = pendingTargetX;
  currentY = pendingTargetY;
  currentFacing = pendingFinalFacing;

  pendingRouteLen = 0;
  routeWaitingConfirmation = false;

  Serial.println();
  Serial.println("========== ROUTE COMPLETE ==========");

  Serial.print("POSITION: (");
  Serial.print(currentX);
  Serial.print(", ");
  Serial.print(currentY);
  Serial.print(") ");

  Serial.println(
    FACING_NAME[currentFacing]
  );
}

// =====================================================
// HANDLE SERIAL COMMAND
// =====================================================

void handleLine(String line) {

  line.trim();

  if (line.length() == 0) {
    return;
  }

  // =================================================
  // WAITING FOR OK
  // =================================================

  if (routeWaitingConfirmation) {

    if (line.equalsIgnoreCase("OK")) {

      executeRoute();

    } else if (
      line.equalsIgnoreCase("CANCEL")
    ) {

      routeWaitingConfirmation = false;
      pendingRouteLen = 0;

      Serial.println(
        "Route cancelled."
      );

    } else {

      Serial.println(
        "Type OK or CANCEL."
      );
    }

    return;
  }

  // =================================================
  // GOTO
  // =================================================

  if (line.startsWith("GOTO")) {

    int spaceIndex =
      line.indexOf(' ');

    if (spaceIndex == -1) {

      Serial.println(
        "Use: GOTO x,y"
      );

      return;
    }

    String coords =
      line.substring(
        spaceIndex + 1
      );

    int commaIndex =
      coords.indexOf(',');

    if (commaIndex == -1) {

      Serial.println(
        "Use: GOTO x,y"
      );

      return;
    }

    long targetX =
      coords
      .substring(
        0,
        commaIndex
      )
      .toInt();

    long targetY =
      coords
      .substring(
        commaIndex + 1
      )
      .toInt();

    planRoute(
      targetX,
      targetY
    );
  }

  else {

    Serial.println(
      "Unknown command."
    );

    Serial.println(
      "Use: GOTO x,y"
    );
  }
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  WiFi.mode(WIFI_STA);

  WiFi.setChannel(1);

  Serial.println(
    "ESP-A starting..."
  );

  // =================================================
  // ESP-NOW
  // =================================================

  if (
    esp_now_init() != ESP_OK
  ) {

    Serial.println(
      "ESP-NOW INIT FAILED"
    );

    return;
  }

  // =================================================
  // ADD ESP-B
  // =================================================

  memset(
    &peerInfo,
    0,
    sizeof(peerInfo)
  );

  memcpy(
    peerInfo.peer_addr,
    ESP_B_MAC,
    6
  );

  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (
    esp_now_add_peer(&peerInfo)
    != ESP_OK
  ) {

    Serial.println(
      "PEER ADD FAILED"
    );

    return;
  }

  // =================================================
  // REGISTER RECEIVE CALLBACK
  // =================================================

  esp_now_register_recv_cb(
    onAckReceived
  );

  // =================================================
  // READY
  // =================================================

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP-A READY");
  Serial.println("==============================");

  Serial.println(
    "Grid unit = 10 cm"
  );

  Serial.println(
    "Forward = 333 ms/unit"
  );

  Serial.println(
    "90 degree turn = 650 ms"
  );

  Serial.println(
    "Encoder = measurement only"
  );

  Serial.println(
    "Use: GOTO x,y"
  );

  Serial.println("==============================");
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  while (Serial.available()) {

    char c = Serial.read();

    if (c == '\n') {

      handleLine(inputLine);

      inputLine = "";

    } else if (c != '\r') {

      inputLine += c;
    }
  }
}
