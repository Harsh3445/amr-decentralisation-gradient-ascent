#include <WiFi.h>
#include <esp_now.h>

uint8_t peerAddress[] = {
  0x20, 0x9B, 0xA9, 0x60, 0xE3, 0xF4
};

typedef struct {
  char message[200];
} Message;

Message outgoingData;
Message incomingData;

esp_now_peer_info_t peerInfo;

void OnDataSent(const wifi_tx_info_t *tx_info,
                esp_now_send_status_t status) {

  if (status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("[ESP-NOW] Delivery Success");
  } else {
    Serial.println("[ESP-NOW] Delivery Fail");
  }
}

void OnDataRecv(const esp_now_recv_info_t *info,
                const uint8_t *data,
                int len) {

  memcpy(&incomingData, data, sizeof(incomingData));

  Serial.println();
  Serial.println("========== MESSAGE FROM ESP32 A ==========");
  Serial.println(incomingData.message);
  Serial.println("===========================================");
  Serial.println();
  Serial.print("Type message: ");
}

void setup() {

  Serial.begin(115200);
  delay(1000);

  WiFi.mode(WIFI_STA);
  WiFi.setChannel(1);

  Serial.println();
  Serial.println("ESP32 B - BIDIRECTIONAL");

  Serial.print("My MAC: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialization failed!");
    return;
  }

  esp_now_register_send_cb(OnDataSent);
  esp_now_register_recv_cb(OnDataRecv);

  memset(&peerInfo, 0, sizeof(peerInfo));

  memcpy(peerInfo.peer_addr, peerAddress, 6);
  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add ESP32 A as peer");
    return;
  }

  Serial.println("ESP32 B ready.");
  Serial.println("Type a message and press ENTER.");
  Serial.print("Type message: ");
}

void loop() {

  if (Serial.available()) {

    String input = Serial.readStringUntil('\n');
    input.trim();

    if (input.length() == 0) {
      Serial.print("Type message: ");
      return;
    }

    memset(&outgoingData, 0, sizeof(outgoingData));

    input.toCharArray(
      outgoingData.message,
      sizeof(outgoingData.message)
    );

    Serial.print("You: ");
    Serial.println(outgoingData.message);

    esp_err_t result = esp_now_send(
      peerAddress,
      (uint8_t *)&outgoingData,
      sizeof(outgoingData)
    );

    if (result != ESP_OK) {
      Serial.print("Send error: ");
      Serial.println(result);
    }

    Serial.print("Type message: ");
  }
}
