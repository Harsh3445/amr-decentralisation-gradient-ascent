#include <WiFi.h>
#include <esp_now.h>

// MAC address of ESP-B (robot)
uint8_t peerAddress[] = {
  0x20, 0x9B, 0xA9, 0x61, 0xBB, 0x20
};

typedef struct {
  char command;
} RobotCommand;

RobotCommand outgoingData;
esp_now_peer_info_t peerInfo;

// ===============================
// SEND CALLBACK
// ===============================
void OnDataSent(const wifi_tx_info_t *tx_info,
                esp_now_send_status_t status) {

  Serial.print("[SEND] ");

  if (status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("SUCCESS");
  } else {
    Serial.println("FAILED");
  }
}

// ===============================
// SETUP
// ===============================
void setup() {

  Serial.begin(115200);
  delay(1000);

  WiFi.mode(WIFI_STA);
  WiFi.setChannel(1);

  // Initialize ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW INIT FAILED");
    return;
  }

  esp_now_register_send_cb(OnDataSent);

  // Add ESP-B as peer
  memset(&peerInfo, 0, sizeof(peerInfo));

  memcpy(peerInfo.peer_addr, peerAddress, 6);

  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("PEER ADD FAILED");
    return;
  }

  Serial.println();
  Serial.println("=================================");
  Serial.println("     ESP-A ROBOT CONTROLLER");
  Serial.println("=================================");
  Serial.println("F = Forward");
  Serial.println("B = Backward");
  Serial.println("L = Left");
  Serial.println("R = Right");
  Serial.println("S = Stop");
  Serial.println("=================================");
}

// ===============================
// LOOP
// ===============================
void loop() {

  if (Serial.available() > 0) {

    char command = Serial.read();

    // Ignore Enter/newline
    if (command == '\n' || command == '\r') {
      return;
    }

    command = toupper(command);

    char actualCommand;

    // =====================================
    // REMAP YOUR PHYSICAL MOTOR DIRECTIONS
    // =====================================

    if (command == 'R') {
      // You press R → robot currently goes FORWARD
      // So send F
      actualCommand = 'F';
    }

    else if (command == 'L') {
      // You press L → robot currently goes BACKWARD
      // So send B
      actualCommand = 'B';
    }

    else if (command == 'F') {
      // You press F → robot currently turns LEFT
      // So send L
      actualCommand = 'L';
    }

    else if (command == 'B') {
      // Temporary assumption
      actualCommand = 'R';
    }

    else if (command == 'S') {
      actualCommand = 'S';
    }

    else {
      Serial.println("Invalid command!");
      return;
    }

    // Put corrected command into packet
    outgoingData.command = actualCommand;

    // Show both commands
    Serial.print("[YOU PRESSED] ");
    Serial.println(command);

    Serial.print("[SENDING] ");
    Serial.println(actualCommand);

    // Send command to ESP-B
    esp_err_t result = esp_now_send(
      peerAddress,
      (uint8_t *)&outgoingData,
      sizeof(outgoingData)
    );

    if (result != ESP_OK) {
      Serial.print("[ERROR] esp_now_send = ");
      Serial.println(result);
    }
  }
}
