ESP-A — controller
#include <WiFi.h>
#include <esp_now.h>

// ESP-B MAC address
uint8_t espBMac[] = {
  0x20, 0x9B, 0xA9, 0x61, 0xBB, 0x20
};

typedef struct {
  char command;
} RobotCommand;

RobotCommand outgoingData;
esp_now_peer_info_t peerInfo;

// ---------- SEND CALLBACK ----------
void OnDataSent(const wifi_tx_info_t *tx_info,
                esp_now_send_status_t status) {

  Serial.print("[SEND] ");

  if (status == ESP_NOW_SEND_SUCCESS)
    Serial.println("SUCCESS");
  else
    Serial.println("FAILED");
}

// ---------- SEND COMMAND ----------
void sendCommand(char command) {

  outgoingData.command = command;

  esp_err_t result = esp_now_send(
    espBMac,
    (uint8_t *)&outgoingData,
    sizeof(outgoingData)
  );

  Serial.print("Command sent: ");
  Serial.println(command);

  if (result != ESP_OK) {
    Serial.print("ERROR: ");
    Serial.println(result);
  }
}

// ---------- SETUP ----------
void setup() {

  Serial.begin(115200);
  delay(1000);

  WiFi.mode(WIFI_STA);
  WiFi.setChannel(1);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW INIT FAILED");
    return;
  }

  esp_now_register_send_cb(OnDataSent);

  memset(&peerInfo, 0, sizeof(peerInfo));

  memcpy(
    peerInfo.peer_addr,
    espBMac,
    6
  );

  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("PEER ADD FAILED");
    return;
  }

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP-A READY");
  Serial.println("==============================");
  Serial.println("Press T to move (0,0) -> (2,3)");
}

// ---------- MAIN ----------
void loop() {

  if (Serial.available()) {

    char command = Serial.read();

    if (command == '\n' || command == '\r')
      return;

    command = toupper(command);

    if (command == 'T') {

      Serial.println();
      Serial.println("Starting movement...");
      Serial.println("(0,0) -> (2,3)");

      // --------------------------------
      // STEP 1: MOVE FORWARD 30 cm
      // --------------------------------
      Serial.println("1. Moving forward 30 cm");

      sendCommand('F');

      delay(1390);

      sendCommand('S');

      delay(500);

      // --------------------------------
      // STEP 2: TURN RIGHT 90 DEGREES
      // --------------------------------
      Serial.println("2. Turning RIGHT 90 degrees");

      /*
         IMPORTANT:
         Your robot turns LEFT when told RIGHT.

         Therefore we send the command that
         physically produces a RIGHT turn.
      */

      sendCommand('L');

      delay(500);

      sendCommand('S');

      delay(500);

      // --------------------------------
      // STEP 3: MOVE FORWARD 20 cm
      // --------------------------------
      Serial.println("3. Moving forward 20 cm");

